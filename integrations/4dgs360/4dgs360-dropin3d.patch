--- /dev/null
+++ b/tests/test_dropin3d_integration.py
@@ -0,0 +1,64 @@
+"""CPU integration tests for the dropin3d port of 4DGS360.
+
+Run from the repository root (needs `pip install dropin3d`):
+    PYTHONPATH=. pytest tests/test_dropin3d_integration.py
+The dropin3d fallbacks themselves are tested in the dropin3d repository.
+"""
+
+import os
+import sys
+import types
+
+import numpy as np
+import torch
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, ROOT)
+
+
+def _install_stubs():
+    """flow3d.init_utils imports viser/cv2 through flow3d.vis.utils."""
+    if "flow3d.vis.utils" not in sys.modules:
+        stub = types.ModuleType("flow3d.vis.utils")
+        stub.get_server = lambda *a, **k: None
+        stub.project_2d_tracks = lambda *a, **k: None
+        sys.modules["flow3d.vis.utils"] = stub
+
+
+def _ref_interp(vals, mask):
+    """Per-track np.interp with edge extension (what interp_masked computes)."""
+    B, M, D = vals.shape
+    out = np.zeros_like(vals)
+    t = np.arange(M)
+    for b in range(B):
+        valid = np.where(mask[b])[0]
+        for d in range(D):
+            out[b, :, d] = np.interp(t, valid, vals[b, valid, d])
+    return out
+
+
+def test_batched_interp_masked_numpy_matches_reference():
+    """CuPy -> NumPy port of the missing-track interpolation."""
+    _install_stubs()
+    from flow3d import init_utils
+
+    rng = np.random.default_rng(0)
+    B, M = 50, 130
+    vals = rng.standard_normal((B, M, 3)).astype(np.float32)
+    mask = rng.random((B, M)) > 0.4
+    mask[:, [0, 64, 128]] = True  # each 64-frame window has a valid frame
+    out = init_utils.batched_interp_masked(vals, mask, batch_num=16, batch_time=64)
+    ref = np.concatenate(
+        [_ref_interp(vals[:, s : s + 64], mask[:, s : s + 64]) for s in range(0, M, 64)],
+        axis=1,
+    )
+    np.testing.assert_allclose(out, ref, rtol=1e-5, atol=1e-5)
+    np.testing.assert_array_equal(out[mask], vals[mask])
+
+
+def test_scene_model_uses_dropin3d_rasterization():
+    _install_stubs()
+    import dropin3d.raster
+    import flow3d.scene_model as sm
+
+    assert sm.rasterization is dropin3d.raster.rasterization
